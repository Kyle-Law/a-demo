apiVersion: kubeadm.k8s.io/v1beta4
kind: JoinConfiguration
discovery:
  bootstrapToken:
    apiServerEndpoint: {{ hostvars[control_plane_host].wg_ip }}:6443
    token: {{ worker_join_token }}
    caCertHashes:
      - {{ worker_join_ca_hash }}
nodeRegistration:
  name: {{ inventory_hostname }}
  criSocket: unix:///run/containerd/containerd.sock
  kubeletExtraArgs:
    - name: node-ip
      value: "{{ wg_ip }}"
