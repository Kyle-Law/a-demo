{% set admin = control_plane_admin_conf.content | b64decode | from_yaml %}
# Generated by infra/ansible from {{ inventory_hostname }}:/etc/kubernetes/admin.conf. Cluster-admin credentials.
apiVersion: v1
kind: Config
clusters:
  - name: {{ cluster_name }}
    cluster:
      server: https://{{ control_plane_public_ip }}:6443
      certificate-authority-data: {{ admin.clusters[0].cluster['certificate-authority-data'] }}
users:
  - name: {{ cluster_name }}-admin
    user:
      client-certificate-data: {{ admin.users[0].user['client-certificate-data'] }}
      client-key-data: {{ admin.users[0].user['client-key-data'] }}
contexts:
  - name: {{ cluster_name }}
    context:
      cluster: {{ cluster_name }}
      user: {{ cluster_name }}-admin
current-context: {{ cluster_name }}
