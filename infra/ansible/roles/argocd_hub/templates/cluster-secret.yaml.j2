apiVersion: v1
kind: Secret
metadata:
  name: cluster-{{ hostvars[item].cluster_name }}
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: cluster
    a-demo.io/fleet: "true"
stringData:
  name: {{ hostvars[item].cluster_name }}
  server: https://{{ hostvars[item].wg_ip }}:6443
  config: '{{ {"bearerToken": hostvars[item].argocd_manager_token, "tlsClientConfig": {"caData": hostvars[item].argocd_manager_ca}} | to_json }}'
