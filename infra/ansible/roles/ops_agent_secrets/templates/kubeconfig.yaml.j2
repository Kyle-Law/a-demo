{# One read-only kubeconfig for cluster hostvars[item].cluster_name. The hub reaches its own API
   in-cluster; the spokes over the WireGuard mesh, like Argo CD does. #}
apiVersion: v1
kind: Config
clusters:
  - name: {{ hostvars[item].cluster_name }}
    cluster:
      server: {{ 'https://kubernetes.default.svc' if hostvars[item].cluster_name == 'c3' else 'https://' ~ hostvars[item].wg_ip ~ ':6443' }}
      certificate-authority-data: {{ hostvars[item].ops_agent_reader_ca }}
users:
  - name: ops-agent-reader
    user:
      token: {{ hostvars[item].ops_agent_reader_token }}
contexts:
  - name: {{ hostvars[item].cluster_name }}
    context:
      cluster: {{ hostvars[item].cluster_name }}
      user: ops-agent-reader
current-context: {{ hostvars[item].cluster_name }}
